# --- General ---
APP_NAME=JobOps AI
ENVIRONMENT=development

# --- Database ---
# Local/prod uses Postgres + pgvector; tests use SQLite in-memory automatically.
DATABASE_URL=postgresql+asyncpg://jobops:jobops@localhost:5432/jobops

# --- Auth (single seeded user) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
SEED_USER_EMAIL=me@example.com
SEED_USER_PASSWORD=change-me

# --- Providers (mock is the default and the only one used in tests/CI) ---
LLM_PROVIDER=mock          # mock | anthropic | openai
EMBEDDING_PROVIDER=mock    # mock | openai
EMBEDDING_DIM=384
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Scoring weights (must sum to 100) and thresholds ---
WEIGHT_STACK=30
WEIGHT_SENIORITY=20
WEIGHT_MODALITY_LOCATION=15
WEIGHT_PROJECTS=15
WEIGHT_SALARY=10
WEIGHT_RISK=10
RECOMMEND_APPLY_MIN=7.0
RECOMMEND_QUICK_MIN=5.0

# --- HTTP ---
CORS_ORIGINS=http://localhost:3000
